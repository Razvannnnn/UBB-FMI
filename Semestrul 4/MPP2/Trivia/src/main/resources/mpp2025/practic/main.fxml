<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mpp2025.practic.controllers.MainController">
   <children>
      <VBox alignment="CENTER" layoutX="1.0" layoutY="1.0" prefHeight="400.0" prefWidth="600.0" spacing="20.0">
         <children>
            <Label fx:id="statusLabel" text="Alege o pozitie" />
            <Label fx:id="timpLabel" text="Timp: 0s" />
            <VBox fx:id="gameVBox" prefHeight="163.0" prefWidth="600.0" />
            <Button mnemonicParsing="false" onAction="#handleRestart" text="Start Joc Nou">
               <VBox.margin>
                  <Insets />
               </VBox.margin></Button>
            <Separator prefWidth="200.0" />
            <Label text="Clasament">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <VBox fx:id="leaderboardVBox" prefHeight="106.0" prefWidth="600.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
