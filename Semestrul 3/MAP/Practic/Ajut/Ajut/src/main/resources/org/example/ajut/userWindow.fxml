<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ajut.UserWindowController">
   <children>
      <TabPane layoutX="14.0" layoutY="14.0" prefHeight="371.0" prefWidth="576.0" tabClosingPolicy="UNAVAILABLE">
