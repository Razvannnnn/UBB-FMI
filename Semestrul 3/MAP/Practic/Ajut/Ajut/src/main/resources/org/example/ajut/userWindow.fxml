                        <VBox alignment="CENTER" layoutX="8.0" layoutY="8.0" prefHeight="321.0" prefWidth="557.0" spacing="15.0">
                           <children>
                              <TextField fx:id="titluField" promptText="Titlu" />
                              <TextField fx:id="descriereField" promptText="Descriere" />
                              <DatePicker fx:id="deadlineDatePicker" promptText="Deadline" />
