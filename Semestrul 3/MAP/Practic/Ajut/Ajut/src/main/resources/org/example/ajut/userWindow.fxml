                           <children>
                              <TableView fx:id="tableNevoi" prefHeight="324.0" prefWidth="276.0">
                                <columns>
                                  <TableColumn fx:id="columnTitlu" prefWidth="75.0" text="Titlu" />
                                  <TableColumn fx:id="columnDescriere" prefWidth="75.0" text="Descriere" />
                                    <TableColumn fx:id="columnDeadline" prefWidth="118.33334350585938" text="Deadline" />
                                </columns>
                              </TableView>
                              <TableView fx:id="tableNevoi2" prefHeight="324.0" prefWidth="279.0">
                                <columns>
                                  <TableColumn fx:id="titluColumn2" prefWidth="75.0" text="C1" />
                                  <TableColumn fx:id="descriereColumn2" prefWidth="75.0" text="C2" />
